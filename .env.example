# Server
PORT=3000
NODE_ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_DAYS=7
# Legacy alias (fallback if JWT_ACCESS_EXPIRES_IN unset)
JWT_EXPIRES_IN=15m

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173

# Cross-system webhook (must match craftsman-api)
WEBHOOK_SECRET=jewelry-demo-webhook-secret

# Craftsman system
CRAFTSMAN_API_URL=http://localhost:3001/api
CRAFTSMAN_ASK_WEBHOOK_PATH=/webhooks/shop/ask-craftsman

# Public URL of this shop API (craftsman replies here)
SHOP_API_PUBLIC_URL=http://localhost:3000/api

# Public base URL for uploaded images (no /api suffix)
PUBLIC_BASE_URL=http://localhost:3000

# Seed demo users/products on boot (set false in production)
SEED_DEMO=false

# Pricing defaults (VND)
SILVER_PRICE_PER_GRAM=28000
DEFAULT_MARGIN_RATE=0.25

# AI explanation — set ONLY ONE of the three keys (auto-detect order: groq → gemini → anthropic).
# Optional force: AI_PROVIDER=groq|gemini|anthropic
# If none set → formula template fallback (still works offline).
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Chat auto-translate (uses same AI key as above)
SALE_LOCALE=vi
DEFAULT_CUSTOMER_LOCALE=en

# Web Push (sale notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@jewelry.local
